{
  "name": "PipeFish revenue intake",
  "nodes": [
    {
      "id": "webhook",
      "name": "Paid inbox webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": { "path": "pipefish-intake", "httpMethod": "POST" },
      "position": [240, 300]
    },
    {
      "id": "qualify",
      "name": "Qualify SKU",
      "type": "n8n-nodes-base.function",
      "parameters": {
        "functionCode": "const body = items[0].json; const sku = body.sku_id || 'mesh.lane.ping'; return [{ json: { ...body, sku_id: sku, approved: String(body.request || '').length >= 12 } }];"
      },
      "position": [480, 300]
    },
    {
      "id": "slack",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "parameters": {
        "channel": "#revops",
        "text": "=PipeFish {{$json.sku_id}} approved={{$json.approved}}"
      },
      "position": [720, 300]
    }
  ],
  "connections": {
    "Paid inbox webhook": { "main": [[{ "node": "Qualify SKU", "type": "main", "index": 0 }]] },
    "Qualify SKU": { "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]] }
  }
}
