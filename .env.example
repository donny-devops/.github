# PipeFish Mesh control-plane environment.
# Copy to .env locally. Never commit real values.

PIPEFISH_ENV=dev
PIPEFISH_LEDGER_PATH=./data/ledger.sqlite
PIPEFISH_MEMORY_PATH=./data/memory.sqlite
PIPEFISH_GATEWAY_ADDR=127.0.0.1:8787

# Secret broker resolution order: env → file → AWS SSM (optional)
PIPEFISH_SECRET_FILE=
AWS_REGION=us-east-1
PIPEFISH_SSM_PREFIX=/pipefish/dev/

# Integrations (leave empty unless the adapter is configured)
SLACK_WEBHOOK_URL=
# Prefer a restricted API key (rk_test_ / rk_live_) over sk_*. Store in SSM/Secrets Manager in AWS.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://pipefishlabs.io/paid/{CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://pipefishlabs.io/cancel
# Only set true after Dashboard → Tax → Registrations shows Collecting.
STRIPE_TAX_REGISTRATION_ACTIVE=false
N8N_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
