# PipeFish Mesh control-plane environment.
# Copy to .env locally. Never commit real values.

PIPEFISH_ENV=dev
PIPEFISH_LEDGER_PATH=./data/ledger.sqlite
PIPEFISH_MEMORY_PATH=./data/memory.sqlite
PIPEFISH_GATEWAY_ADDR=127.0.0.1:8787

# Secret broker resolution order: env → file → AWS SSM (optional)
PIPEFISH_SECRET_FILE=
AWS_REGION=us-east-1
PIPEFISH_SSM_PREFIX=/pipefish/dev/

# Integrations (leave empty unless the adapter is configured)
SLACK_WEBHOOK_URL=
STRIPE_SECRET_KEY=
N8N_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
