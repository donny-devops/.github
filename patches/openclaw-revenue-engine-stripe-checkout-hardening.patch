+export async function createBillingPortalSession(
+  input: BillingPortalRequest,
+): Promise<BillingPortalResult> {
+  if (!input.customer_id?.trim()) {
+    throw new Error('customer_id is required');
+  }
+
+  const returnUrl =
+    input.return_url ??
+    `${optionalEnv('PUBLIC_BASE_URL', 'http://localhost:3000')}/revenue/earnings`;
+
+  if (isSimulatedStripe()) {
+    return {
+      url: `${returnUrl}?portal=simulated&customer=${encodeURIComponent(input.customer_id)}`,
+      simulated: true,
+    };
+  }
+
+  const stripe = getStripe();
+  const session = await stripe.billingPortal.sessions.create({
+    customer: input.customer_id,
+    return_url: returnUrl,
+  });
+
+  if (!session.url) {
+    throw new Error('Stripe did not return a billing portal URL');
+  }
+
+  return { url: session.url, simulated: false };
