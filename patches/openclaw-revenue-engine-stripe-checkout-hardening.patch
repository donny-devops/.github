+import { encryptionEnabled } from '../security/crypto';
+import { STRIPE_API_VERSION, isSimulatedStripe } from '../billing/stripeClient';
+
+export interface ReadinessReport {
+  status: 'ok' | 'degraded';
+  timestamp: string;
+  stripe: {
+    api_version: typeof STRIPE_API_VERSION;
+    mode: 'simulated' | 'live';
+    rak_configured: boolean;
+  };
+  encryption: { enabled: boolean };
+  tax_registration_active: boolean;
+  mesh_gateway: boolean;
+}
+
+export function readinessReport(): ReadinessReport {
+  const rakConfigured = Boolean(process.env.STRIPE_RESTRICTED_KEY?.trim());
+  const encryption = encryptionEnabled();
+  let mode: 'simulated' | 'live' = 'simulated';
+  let stripeReady = true;
+  try {
+    mode = isSimulatedStripe() ? 'simulated' : 'live';
+  } catch {
+    stripeReady = false;
+  }
+  const degraded =
+    !stripeReady || (process.env.NODE_ENV === 'production' && (!rakConfigured || !encryption));
+  return {
+    status: degraded ? 'degraded' : 'ok',
+    timestamp: new Date().toISOString(),
+    stripe: {
+      api_version: STRIPE_API_VERSION,
+      mode,
+      rak_configured: rakConfigured,
+    },
+    encryption: { enabled: encryption },
+    tax_registration_active: process.env.STRIPE_TAX_REGISTRATION_ACTIVE === 'true',
+    mesh_gateway: Boolean(process.env.PIPEFISH_GATEWAY_URL?.trim()),
+  };
+}
