+const buildLineItems = (
+  classification: ClassifiedPaidRequest,
+  mode: BillingMode,
+  amountCents: number,
+  currency: string,
+): StripeCheckoutLineItem[] => {
+  const retainerPrice = optionalEnv('STRIPE_PRICE_RETAINER');
