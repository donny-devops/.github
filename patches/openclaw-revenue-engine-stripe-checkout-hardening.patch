+describe('RAK-first Stripe key resolution', () => {
+  const originalEnv = { ...process.env };
+
+  afterEach(() => {
+    process.env = { ...originalEnv };
+    jest.resetModules();
+  });
+
+  it('prefers STRIPE_RESTRICTED_KEY over STRIPE_SECRET_KEY', () => {
+    process.env.NODE_ENV = 'test';
+    process.env.STRIPE_RESTRICTED_KEY = 'rk_test_preferred_key';
+    process.env.STRIPE_SECRET_KEY = 'sk_test_fallback_key';
+
+    jest.isolateModules(() => {
+      // eslint-disable-next-line @typescript-eslint/no-require-imports
+      const { resolveStripeKey } = require('../../src/billing/stripeClient') as typeof import('../../src/billing/stripeClient');
+      expect(resolveStripeKey()).toBe('rk_test_preferred_key');
+    });
+  });
+
+  it('falls back to STRIPE_SECRET_KEY when no RAK is set', () => {
+    process.env.NODE_ENV = 'test';
+    delete process.env.STRIPE_RESTRICTED_KEY;
+    process.env.STRIPE_SECRET_KEY = 'sk_test_fallback_key';
+
+    jest.isolateModules(() => {
+      // eslint-disable-next-line @typescript-eslint/no-require-imports
+      const { resolveStripeKey } = require('../../src/billing/stripeClient') as typeof import('../../src/billing/stripeClient');
+      expect(resolveStripeKey()).toBe('sk_test_fallback_key');
+    });
+  });
+
+  it('requires rk_live_ in production unless emergency secret-key cutover is set', () => {
+    process.env.NODE_ENV = 'production';
+    delete process.env.STRIPE_ALLOW_SECRET_KEY;
+    process.env.STRIPE_RESTRICTED_KEY = 'sk_live_not_a_restricted_key';
+
+    expect(() => {
+      jest.isolateModules(() => {
+        // eslint-disable-next-line @typescript-eslint/no-require-imports
+        require('../../src/billing/stripeClient');
+      });
+    }).toThrow(/rk_live_/);
+  });
+
+  it('allows sk_live_ in production only with STRIPE_ALLOW_SECRET_KEY=true', () => {
+    process.env.NODE_ENV = 'production';
+    process.env.STRIPE_ALLOW_SECRET_KEY = 'true';
+    delete process.env.STRIPE_RESTRICTED_KEY;
+    process.env.STRIPE_SECRET_KEY = 'sk_live_emergency_cutover_key';
+
+    jest.isolateModules(() => {
+      // eslint-disable-next-line @typescript-eslint/no-require-imports
+      const { resolveStripeKey, STRIPE_API_VERSION } = require('../../src/billing/stripeClient') as typeof import('../../src/billing/stripeClient');
+      expect(resolveStripeKey()).toBe('sk_live_emergency_cutover_key');
+      expect(STRIPE_API_VERSION).toBe('2026-09-30.endive');
+    });
+  });
+});
