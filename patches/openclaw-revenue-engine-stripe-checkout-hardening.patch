diff --git a/src/mesh/envelope.ts b/src/mesh/envelope.ts
new file mode 100644
index 0000000..9a3ad7a
--- /dev/null
+++ b/src/mesh/envelope.ts
@@ -0,0 +1,81 @@
+import { randomUUID } from 'crypto';
+
+export interface Envelope {
+  id: string;
+  source: string;
+  target: string;
+  intent: string;
+  payload: Record<string, unknown>;
+  tokens: string[];
+  trace_id: string;
+  created_at: string;
+}
+
+const audit: Envelope[] = [];
+const handlers = new Map<string, Array<(envelope: Envelope) => Envelope | void | Promise<Envelope | void>>>();
+
+export function resetMesh(): void {
+  audit.length = 0;
+  handlers.clear();
+}
+
+export function subscribe(
+  target: string,
+  handler: (envelope: Envelope) => Envelope | void | Promise<Envelope | void>,
+): void {
+  const list = handlers.get(target) ?? [];
+  list.push(handler);
+  handlers.set(target, list);
+}
+
+export function createEnvelope(input: {
+  source: string;
+  target: string;
+  intent: string;
+  payload?: Record<string, unknown>;
+  tokens?: string[];
+  trace_id?: string;
+}): Envelope {
+  return {
+    id: randomUUID(),
+    source: input.source,
+    target: input.target,
+    intent: input.intent,
+    payload: input.payload ?? {},
+    tokens: input.tokens ?? ['commerce:write'],
+    trace_id: input.trace_id ?? randomUUID(),
+    created_at: new Date().toISOString(),
+  };
+}
+
+export async function publish(envelope: Envelope): Promise<Envelope[]> {
+  audit.push(envelope);
+  const replies: Envelope[] = [];
+  for (const handler of handlers.get(envelope.target) ?? []) {
+    const result = await handler(envelope);
+    if (result) {
+      audit.push(result);
+      replies.push(result);
+    }
+  }
+
+  const gateway = process.env.PIPEFISH_GATEWAY_URL?.trim();
+  if (gateway && process.env.NODE_ENV !== 'test') {
+    try {
+      await fetch(`${gateway.replace(/\/$/, '')}/v1/envelopes`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(envelope),
+      });
+    } catch (err) {
+      const message = err instanceof Error ? err.message : 'Unknown mesh publish error';
+      console.error(`PipeFish gateway publish failed: ${message}`);
+    }
+  }
+
+  return replies;
+}
+
+export function listMeshAudit(limit = 50): Envelope[] {
+  return audit.slice(-limit).reverse().map((item) => ({ ...item, payload: { ...item.payload } }));
+}
diff --git a/src/observability/metrics.ts b/src/observability/metrics.ts
new file mode 100644
index 0000000..fafd8de
--- /dev/null
+++ b/src/observability/metrics.ts
@@ -0,0 +1,26 @@
+const counters = new Map<string, number>();
+const lastEvents = new Map<string, string>();
+
+export function resetMetrics(): void {
+  counters.clear();
+  lastEvents.clear();
+}
+
+export function incMetric(name: string, by = 1): number {
+  const next = (counters.get(name) ?? 0) + by;
+  counters.set(name, next);
+  lastEvents.set(name, new Date().toISOString());
+  return next;
+}
+
+export function getMetric(name: string): number {
+  return counters.get(name) ?? 0;
+}
+
+export function metricsSnapshot(): Record<string, { count: number; last_at?: string }> {
+  const snapshot: Record<string, { count: number; last_at?: string }> = {};
+  for (const [name, count] of counters.entries()) {
+    snapshot[name] = { count, last_at: lastEvents.get(name) };
+  }
+  return snapshot;
+}
