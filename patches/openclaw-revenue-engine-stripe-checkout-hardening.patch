new file mode 100644
index 0000000..fa9ac60
--- /dev/null
+++ b/src/security/intrusion.ts
@@ -0,0 +1,65 @@
+import { incMetric } from '../observability/metrics';
+import { recordAudit } from '../governance/auditLog';
+
+export type IntrusionSignal =
+  | 'webhook_signature_failure'
+  | 'charge_dispute'
+  | 'charge_refund'
+  | 'early_fraud_warning'
+  | 'webhook_burst';
+
+interface SignalWindow {
+  at: number;
+  signal: IntrusionSignal;
+}
+
+const windowMs = (): number => Number(process.env.INTRUSION_WINDOW_MS ?? 5 * 60_000);
+const signals: SignalWindow[] = [];
+
+const thresholds: Record<IntrusionSignal, number> = {
+  webhook_signature_failure: 8,
+  charge_dispute: 3,
+  charge_refund: 5,
+  early_fraud_warning: 1,
+  webhook_burst: 40,
+};
+
+export function resetIntrusion(): void {
+  signals.length = 0;
+}
+
+const prune = (now: number): void => {
+  const cutoff = now - windowMs();
+  while (signals.length && signals[0].at < cutoff) {
+    signals.shift();
+  }
+};
+
+export function noteIntrusion(signal: IntrusionSignal, details: Record<string, string> = {}): boolean {
+  const now = Date.now();
+  prune(now);
+  signals.push({ at: now, signal });
+  incMetric(`intrusion.${signal}`);
+
+  const count = signals.filter((item) => item.signal === signal).length;
+  const tripped = count >= thresholds[signal];
+  if (tripped) {
+    recordAudit({
+      actor: 'intrusion-detector',
+      action: 'threshold_exceeded',
+      resource: signal,
+      outcome: 'alert',
+      trace_id: details.trace_id ?? 'intrusion',
+      details: { ...details, count: String(count) },
+    });
+  }
+  return tripped;
+}
+
+export function intrusionSnapshot(): Record<string, number> {
+  prune(Date.now());
+  return signals.reduce<Record<string, number>>((acc, item) => {
+    acc[item.signal] = (acc[item.signal] ?? 0) + 1;
+    return acc;
+  }, {});
+}
