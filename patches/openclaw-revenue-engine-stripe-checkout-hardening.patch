@@ -0,0 +1,68 @@
+import { recordAudit } from '../governance/auditLog';
+import { createEnvelope, publish } from '../mesh/envelope';
+import { incMetric } from '../observability/metrics';
+import { PaymentRecord } from '../billing/types';
+import { DAG, DAGResult } from './dag';
+
+export interface BillingDagInput {
+  payment: PaymentRecord;
+  eventType: string;
+  eventId: string;
+  outcome: 'paid' | 'failed' | 'pending' | 'canceled';
+}
+
+export async function runBillingFulfillmentDag(input: BillingDagInput): Promise<DAGResult> {
+  const dag = new DAG('billing-fulfillment');
+  dag.addNode('record_audit', () => {
+    incMetric(`billing.dag.${input.outcome}`);
+    return recordAudit({
+      actor: 'stripe-webhook',
+      action: 'fulfillment_dag',
+      resource: input.payment.id,
+      outcome: input.outcome,
+      trace_id: input.eventId,
+      details: {
+        event_type: input.eventType,
+        lane: input.payment.lane,
+        service: input.payment.service,
+        amount_cents: String(input.payment.amount_cents),
+      },
+    });
+  });
+  dag.addNode(
+    'emit_mesh',
+    async () => {
+      const envelope = createEnvelope({
+        source: 'openclaw-revenue-engine',
+        target: 'pipefish.control-plane',
+        intent: input.outcome === 'paid' ? 'commerce.recognize' : 'commerce.risk',
+        tokens: ['commerce:write', 'mesh:route'],
+        trace_id: input.eventId,
+        payload: {
+          payment_id: input.payment.id,
+          lane: input.payment.lane,
+          service: input.payment.service,
+          status: input.outcome,
+          sku: input.payment.service === 'gitops-retainer' ? 'mesh.retain.ops' : input.payment.service,
+        },
+      });
+      return publish(envelope);
+    },
+    ['record_audit'],
+  );
+  dag.addNode(
+    'notify_ops',
+    (ctx) => {
+      incMetric('billing.ops.notify');
+      return {
+        notified: true,
+        mesh_replies: Array.isArray((ctx.deps as Record<string, unknown>)?.emit_mesh)
+          ? ((ctx.deps as Record<string, unknown>).emit_mesh as unknown[]).length
+          : 0,
+      };
+    },
+    ['emit_mesh'],
+  );
+
+  return dag.run({ payment: input.payment, eventType: input.eventType });
+}
diff --git a/src/orchestration/dag.ts b/src/orchestration/dag.ts
new file mode 100644
index 0000000..ae5c38e
--- /dev/null
+++ b/src/orchestration/dag.ts
@@ -0,0 +1,124 @@
+export type NodeStatus = 'ok' | 'error' | 'skipped';
+
+export type NodeFn = (ctx: Record<string, unknown>) => unknown | Promise<unknown>;
+
+export interface NodeResult {
+  name: string;
+  status: NodeStatus;
+  output?: unknown;
+  error?: string;
+}
+
+export interface DAGResult {
+  name: string;
+  status: 'ok' | 'error';
+  nodes: Record<string, NodeResult>;
+}
+
+interface Node {
+  name: string;
+  fn: NodeFn;
+  deps: string[];
+}
+
+export class DAG {
+  readonly name: string;
+  private readonly nodes = new Map<string, Node>();
+
+  constructor(name: string) {
+    this.name = name;
+  }
+
+  addNode(name: string, fn: NodeFn, deps: string[] = []): this {
+    if (this.nodes.has(name)) {
+      throw new Error(`duplicate node: ${name}`);
+    }
+    this.nodes.set(name, { name, fn, deps: [...deps] });
+    return this;
+  }
+
+  private validate(): void {
+    for (const node of this.nodes.values()) {
+      for (const dep of node.deps) {
+        if (!this.nodes.has(dep)) {
+          throw new Error(`${node.name} depends on missing node ${dep}`);
+        }
+      }
+    }
+
+    const visiting = new Set<string>();
+    const seen = new Set<string>();
+    const walk = (name: string): void => {
+      if (seen.has(name)) return;
+      if (visiting.has(name)) {
+        throw new Error(`cycle detected at ${name}`);
+      }
+      visiting.add(name);
+      for (const dep of this.nodes.get(name)?.deps ?? []) {
+        walk(dep);
+      }
+      visiting.delete(name);
+      seen.add(name);
+    };
+    for (const name of this.nodes.keys()) {
+      walk(name);
+    }
+  }
+
+  async run(context: Record<string, unknown> = {}): Promise<DAGResult> {
+    this.validate();
+    const results: Record<string, NodeResult> = {};
+    const inDegree = new Map<string, number>();
+    const dependents = new Map<string, string[]>();
+
+    for (const node of this.nodes.values()) {
+      inDegree.set(node.name, node.deps.length);
+      dependents.set(node.name, dependents.get(node.name) ?? []);
+      for (const dep of node.deps) {
+        const list = dependents.get(dep) ?? [];
+        list.push(node.name);
+        dependents.set(dep, list);
+      }
+    }
+
+    let ready = [...inDegree.entries()].filter(([, degree]) => degree === 0).map(([name]) => name);
+
+    const execute = async (name: string): Promise<NodeResult> => {
+      const node = this.nodes.get(name);
+      if (!node) {
+        return { name, status: 'error', error: 'missing node' };
+      }
+      if (node.deps.some((dep) => results[dep]?.status !== 'ok')) {
+        return { name, status: 'skipped', error: 'upstream failed' };
+      }
+      try {
+        const local = {
+          ...context,
+          deps: Object.fromEntries(node.deps.map((dep) => [dep, results[dep]?.output])),
+        };
+        const output = await node.fn(local);
+        return { name, status: 'ok', output };
+      } catch (err) {
+        return { name, status: 'error', error: err instanceof Error ? err.message : 'Unknown error' };
+      }
+    };
+
+    while (ready.length) {
+      const batch = ready;
+      ready = [];
+      const completed = await Promise.all(batch.map((name) => execute(name)));
+      for (const result of completed) {
+        results[result.name] = result;
+        for (const child of dependents.get(result.name) ?? []) {
+          inDegree.set(child, (inDegree.get(child) ?? 1) - 1);
+          if (inDegree.get(child) === 0) {
+            ready.push(child);
+          }
+        }
+      }
+    }
+
+    const status = Object.values(results).some((node) => node.status === 'error') ? 'error' : 'ok';
+    return { name: this.name, status, nodes: results };
+  }
+}
