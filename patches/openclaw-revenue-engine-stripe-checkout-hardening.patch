+import { incMetric, metricsSnapshot } from '../../src/observability/metrics';
+import { readinessReport } from '../../src/observability/readiness';
+import { DAG } from '../../src/orchestration/dag';
+import { runBillingFulfillmentDag } from '../../src/orchestration/billingDag';
+import { hmacSha256Hex, openSealed, safeEqual, seal } from '../../src/security/crypto';
+import { noteIntrusion, intrusionSnapshot } from '../../src/security/intrusion';
+import { redactSecrets } from '../../src/security/redact';
+
+describe('cryptography', () => {
+  const originalKey = process.env.OPENCLAW_ENCRYPTION_KEY;
+
+  afterEach(() => {
+    process.env.OPENCLAW_ENCRYPTION_KEY = originalKey;
+    resetLedger();
+  });
+
+  it('seals and opens PII with AES-256-GCM', () => {
+    process.env.OPENCLAW_ENCRYPTION_KEY = 'unit-test-encryption-passphrase';
+    const sealed = seal('buyer@example.com');
+    expect(sealed).toMatch(/^enc:v1:/);
+    expect(openSealed(sealed)).toBe('buyer@example.com');
+  });
+
+  it('returns decrypted emails from the ledger', () => {
+    process.env.OPENCLAW_ENCRYPTION_KEY = 'unit-test-encryption-passphrase';
+    const payment = createPayment({
+      lane: 'small-request',
+      service: 'repo-triage',
+      amount_cents: 1900,
+      currency: 'usd',
+      customer_email: 'buyer@example.com',
+      simulated: true,
+    });
+    expect(getPayment(payment.id)?.customer_email).toBe('buyer@example.com');
+  });
+
+  it('compares secrets in constant time and redacts RAKs', () => {
+    expect(safeEqual('abc', 'abc')).toBe(true);
+    expect(safeEqual('abc', 'abd')).toBe(false);
+    expect(hmacSha256Hex('payload', 'secret')).toHaveLength(64);
+    expect(redactSecrets('rk_test_abc123XYZ')).toBe('[REDACTED]');
+  });
+});
+
+describe('async DAG', () => {
+  it('skips downstream nodes when an upstream node fails', async () => {
+    const dag = new DAG('test');
+    dag.addNode('ok', () => 1);
+    dag.addNode('boom', () => {
+      throw new Error('fail');
+    });
+    dag.addNode('child', () => 'should skip', ['boom']);
+    const result = await dag.run();
+    expect(result.status).toBe('error');
+    expect(result.nodes.child.status).toBe('skipped');
+  });
+
+  it('rejects cycles', async () => {
+    const dag = new DAG('cycle');
+    dag.addNode('a', () => 1, ['b']);
+    dag.addNode('b', () => 1, ['a']);
+    await expect(dag.run()).rejects.toThrow(/cycle/);
+  });
+});
+
+describe('governance, mesh, observability, intrusion, sales', () => {
+  beforeEach(() => resetLedger());
+
+  it('records audit events and metrics', () => {
+    recordAudit({
+      actor: 'test',
+      action: 'checkout.create',
+      resource: 'pay_1',
+      outcome: 'ok',
+      trace_id: 'tr_1',
+      details: { lane: 'small-request' },
+    });
+    incMetric('checkout.payment');
+    expect(listAuditEvents()[0]?.action).toBe('checkout.create');
+    expect(metricsSnapshot()['checkout.payment']?.count).toBe(1);
+  });
+
+  it('publishes A2A envelopes on the mesh bus', async () => {
+    subscribe('pipefish.control-plane', (envelope) => ({
+      ...envelope,
+      source: 'pipefish.control-plane',
+      target: envelope.source,
+      intent: 'ack',
+    }));
+    const envelope = createEnvelope({
+      source: 'openclaw-revenue-engine',
+      target: 'pipefish.control-plane',
+      intent: 'commerce.recognize',
+      payload: { sku: 'mesh.retain.ops' },
+    });
+    const replies = await publish(envelope);
+    expect(replies[0]?.intent).toBe('ack');
+    expect(listMeshAudit()[0]?.tokens).toEqual(['commerce:write']);
+  });
+
+  it('runs the billing fulfillment DAG', async () => {
+    const payment = createPayment({
+      lane: 'gitops-retainer',
+      service: 'gitops-retainer',
+      amount_cents: 800000,
+      currency: 'usd',
+      simulated: false,
+    });
+    const result = await runBillingFulfillmentDag({
+      payment,
+      eventType: 'checkout.session.async_payment_succeeded',
+      eventId: 'evt_test',
+      outcome: 'paid',
+    });
+    expect(result.status).toBe('ok');
+    expect(result.nodes.emit_mesh.status).toBe('ok');
+    expect(listMeshAudit()[0]?.payload).toMatchObject({ sku: 'mesh.retain.ops' });
+  });
+
+  it('flags Radar-style fraud signals', () => {
+    expect(noteIntrusion('early_fraud_warning', { trace_id: 'evt_1' })).toBe(true);
+    expect(intrusionSnapshot().early_fraud_warning).toBe(1);
+  });
+
+  it('lists the GitOps retainer as a subscription offer', () => {
+    const retainer = listPublicOffers().find((offer) => offer.slug === 'gitops-retainer');
+    expect(retainer).toMatchObject({
+      price: 8000,
+      billing: 'subscription',
+    });
+  });
+
+  it('reports Stripe API version on readiness', () => {
+    const report = readinessReport();
+    expect(report.stripe.api_version).toBe('2026-09-30.endive');
+    expect(['ok', 'degraded']).toContain(report.status);
+  });
+});
