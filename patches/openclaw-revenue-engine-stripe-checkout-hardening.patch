+import { listRevenueLanes, listRevenueServices } from '../revenue/serviceCatalog';
+
+export interface PublicOffer {
+  slug: string;
+  name: string;
+  price: number;
+  currency: string;
+  billing: 'payment' | 'subscription';
+  sla_hours: number;
+  cta: string;
+  recommended_services: string[];
+}
+
+export function listPublicOffers(): PublicOffer[] {
+  const services = listRevenueServices();
+  const lanes = listRevenueLanes();
+  return lanes.map((lane) => {
+    const billing = lane.billing ?? 'payment';
+    return {
+      slug: lane.slug,
+      name: lane.name,
+      price: lane.price,
+      currency: 'USD',
+      billing,
+      sla_hours: lane.sla_hours,
+      cta: billing === 'subscription' ? 'Start monthly retainer on Stripe Checkout' : 'Pay this request on Stripe Checkout',
+      recommended_services: services
+        .filter((service) => service.recommended_lane === lane.slug)
+        .map((service) => service.slug),
+    };
+  });
+}
