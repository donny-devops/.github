+    delete process.env.STRIPE_PRICE_RETAINER;
+    delete process.env.STRIPE_TAX_REGISTRATION_ACTIVE;
+  });
+
+  afterEach(() => {
+    process.env.STRIPE_MODE = 'simulated';
+    process.env.NODE_ENV = 'test';
+  });
+
+  it('omits payment_method_types and sets an openclaw integration_identifier', async () => {
+    mockCreateSession.mockResolvedValueOnce({
+      id: 'cs_live_payment',
+      url: 'https://checkout.stripe.com/c/pay/cs_live_payment',
+    });
+
+    const result = await createLaneCheckout({
+      body: 'Please review my GitHub portfolio repository and README.',
+      customer_email: 'buyer@example.com',
+    });
+
+    const [params, options] = mockCreateSession.mock.calls[0] as [Record<string, unknown>, Record<string, unknown>];
+    expect(params).not.toHaveProperty('payment_method_types');
+    expect(params.mode).toBe('payment');
+    expect(params.integration_identifier).toEqual(expect.stringMatching(/^openclaw-[a-z]{8}$/));
+    expect(params.automatic_tax).toBeUndefined();
+    expect(options).toEqual({ idempotencyKey: result.payment.id });
+  });
+
+  it('creates subscription Checkout for the GitOps retainer', async () => {
