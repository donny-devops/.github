diff --git a/src/security/crypto.ts b/src/security/crypto.ts
new file mode 100644
index 0000000..55621a3
--- /dev/null
+++ b/src/security/crypto.ts
@@ -0,0 +1,69 @@
+import { createCipheriv, createDecipheriv, createHmac, hkdfSync, randomBytes, timingSafeEqual } from 'crypto';
+
+const PREFIX = 'enc:v1:';
+const INFO = 'openclaw-revenue-ledger-pii';
+const SALT = 'openclaw-revenue-engine';
+
+const encryptionKey = (): Buffer | null => {
+  const raw = process.env.OPENCLAW_ENCRYPTION_KEY?.trim();
+  if (!raw) {
+    if (process.env.NODE_ENV === 'production') {
+      throw new Error('OPENCLAW_ENCRYPTION_KEY is required in production to seal customer PII');
+    }
+    return null;
+  }
+  return Buffer.from(hkdfSync('sha256', raw, SALT, INFO, 32));
+};
+
+export function seal(plaintext?: string): string | undefined {
+  if (!plaintext) {
+    return plaintext;
+  }
+  const key = encryptionKey();
+  if (!key) {
+    return plaintext;
+  }
+  const iv = randomBytes(12);
+  const cipher = createCipheriv('aes-256-gcm', key, iv);
+  const encrypted = Buffer.concat([cipher.update(plaintext, 'utf8'), cipher.final()]);
+  const tag = cipher.getAuthTag();
+  return `${PREFIX}${iv.toString('base64url')}.${tag.toString('base64url')}.${encrypted.toString('base64url')}`;
+}
+
+export function openSealed(value?: string): string | undefined {
+  if (!value || !value.startsWith(PREFIX)) {
+    return value;
+  }
+  const key = encryptionKey();
+  if (!key) {
+    return value;
+  }
+  const [, packed] = value.split(PREFIX);
+  const [ivB64, tagB64, dataB64] = packed.split('.');
+  if (!ivB64 || !tagB64 || !dataB64) {
+    throw new Error('Malformed sealed payload');
+  }
+  const decipher = createDecipheriv('aes-256-gcm', key, Buffer.from(ivB64, 'base64url'));
+  decipher.setAuthTag(Buffer.from(tagB64, 'base64url'));
+  return Buffer.concat([
+    decipher.update(Buffer.from(dataB64, 'base64url')),
+    decipher.final(),
+  ]).toString('utf8');
+}
+
+export function hmacSha256Hex(payload: string, secret: string): string {
+  return createHmac('sha256', secret).update(payload).digest('hex');
+}
+
+export function safeEqual(left: string, right: string): boolean {
+  const a = Buffer.from(left);
+  const b = Buffer.from(right);
+  if (a.length !== b.length) {
+    return false;
+  }
+  return timingSafeEqual(a, b);
+}
+
+export function encryptionEnabled(): boolean {
+  return Boolean(process.env.OPENCLAW_ENCRYPTION_KEY?.trim());
+}
